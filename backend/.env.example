# Copy to .env and fill in real values.
# Non-secret config lives in config/app.yaml — do not add it here.

# Required
OPENAI_API_KEY=sk-...

# Optional — web search (leave blank to disable)
TAVILY_API_KEY=tvly-...

# Optional — voice agent REST API protection (leave blank to disable)
VOICE_AGENT_API_KEY=

# MongoDB — local default; replace with Atlas URI (mongodb+srv://...) for production
MONGODB_URI=mongodb://localhost:27017

# Qdrant Cloud — leave blank to use local Qdrant at localhost:6333
QDRANT_URL=
QDRANT_API_KEY=
